{
  "name": "@siteoshq/sanity",
  "version": "0.2.0",
  "private": false,
  "description": "SiteOS SEO and content checks inside Sanity Studio",
  "homepage": "https://github.com/pixel-point/siteos-sanity-plugin#readme",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "siteos",
    "seo",
    "content-review"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-point/siteos-sanity-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/pixel-point/siteos-sanity-plugin/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/project-public.test.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "project:public": "node scripts/project-public.mjs",
    "prepack": "pnpm build",
    "reconcile:public": "node scripts/reconcile-public.mjs"
  },
  "peerDependencies": {
    "sanity": "^6.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.1.15"
  },
  "dependencies": {
    "@sanity/ui": "^4.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "^20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.16.0",
    "styled-components": "^6.1.15",
    "typescript": "5.8.2",
    "vitest": "^3.2.4",
    "vite": "8.1.5"
  },
  "packageManager": "pnpm@10.11.0"
}
